{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CacheSettings": {
    "AggregationCacheKey": "aggregated-api-data",
    "DurationInMinutes": 5
  },
  "JwtSettings": {
    "Issuer": "API_Aggregation",
    "Audience": "API_Aggregation_Client",
    "SecretKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_123456789"
  },
  "TestUser": {
    "Username": "user",
    "Password": "pass"
  },
  "AllowedHosts": "*"
}
